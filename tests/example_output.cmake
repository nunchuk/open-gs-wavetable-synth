# Runs an example on tests/data and checks what it writes:
#   MODE=render_wav      its WAV of probe1.mid on sine.dls has the golden SHA-256 (golden.tsv);
#   MODE=audio_callback  its 48 kHz stream equals gswavetable-render --48k's samples, then silence.
#   cmake -DMODE=... -DEXAMPLE=... [-DRENDER=gswavetable-render] [-DEMULATOR=node] -DDATA=tests/data
#         -DOUT=<a scratch directory> -P example_output.cmake
set(bank "${DATA}/sine.dls")
set(midi "${DATA}/probe1.mid")
file(MAKE_DIRECTORY "${OUT}")
if(MODE STREQUAL "render_wav")
  execute_process(COMMAND ${EMULATOR} "${EXAMPLE}" "${bank}" "${midi}" "${OUT}/render_wav.wav" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "render_wav failed: ${rc}")
  endif()
  file(STRINGS "${DATA}/golden.tsv" row REGEX "^probe1\\.sine\t")
  string(REPLACE "\t" ";" fields "${row}")
  list(GET fields 4 expected)
  file(SHA256 "${OUT}/render_wav.wav" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "render_wav wrote ${actual}, the golden render is ${expected}")
  endif()
  message(STATUS "render_wav: the golden render (${actual})")
elseif(MODE STREQUAL "audio_callback")
  execute_process(COMMAND ${EMULATOR} "${RENDER}" --48k "${bank}" "${midi}" "${OUT}/render-48k.wav" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "gswavetable-render --48k failed: ${rc}")
  endif()
  execute_process(COMMAND ${EMULATOR} "${EXAMPLE}" "${bank}" "${midi}" "${OUT}/audio_callback.f32" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "audio_callback failed: ${rc}")
  endif()
  file(SIZE "${OUT}/render-48k.wav" wav_size)
  math(EXPR samples_size "${wav_size} - 58") # the float WAV's header: RIFF, fmt (18), fact, data
  file(READ "${OUT}/render-48k.wav" offline HEX OFFSET 58)
  file(READ "${OUT}/audio_callback.f32" streamed HEX LIMIT ${samples_size})
  file(READ "${OUT}/audio_callback.f32" after HEX OFFSET ${samples_size})
  if(NOT streamed STREQUAL offline)
    message(FATAL_ERROR "audio_callback's stream differs from gswavetable-render --48k")
  endif()
  if(NOT after MATCHES "^0*$")
    message(FATAL_ERROR "audio_callback wrote sound after the song's end")
  endif()
  message(STATUS "audio_callback: gswavetable-render --48k's ${samples_size} bytes, then silence")
else()
  message(FATAL_ERROR "MODE: render_wav or audio_callback")
endif()
